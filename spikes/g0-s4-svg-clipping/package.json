{
  "name": "ganttpilot-spike-s4-svg-clipping",
  "version": "0.0.0",
  "private": true,
  "description": "G4-S 准入定标实验：SVG 裁剪有效性、浏览器首屏与滚动定标（spike 代码，不进主干）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "run": "node src/run-all.mts",
    "browser": "node src/browser-run.mts",
    "wps:idx": "pwsh -File src/wps-connector-idx.ps1",
    "wps:elbow": "pwsh -File src/wps-elbow-retest.ps1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1"
  }
}
