{
  "name": "@ganttpilot/xlsx-protocol",
  "version": "0.0.0",
  "description": "xlsx 导入/导出协议：缩进与 WBS 双解析、依赖列语法、规范化导出（零 DOM / 零框架依赖）",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "@ganttpilot/engine": "workspace:*"
  }
}
