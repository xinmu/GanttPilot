{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  // 测试不进入发布产物：`*.spec.ts` 是测试；测试侧的互证实现（逐日循环日历）已按 P3/C4 迁到
  // `test/`，`include` 因此天然不覆盖它——不再需要"逐个文件点名排除"（那种做法正是 C4 要清掉的含糊）。
  // 两者仍受 Vitest 与 `pnpm lint` 覆盖。
  "exclude": ["src/**/*.spec.ts", "lint-boundary"]
}
