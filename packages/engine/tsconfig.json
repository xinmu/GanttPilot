{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  // 测试与**测试侧手段**不进入发布产物：
  // - `*.spec.ts` 是测试；
  // - `loopCalendar.ts` 是 G1.1 出口条件所需的「逐日循环」互证实现（故意不进公共 API，
  //   见其文件头注释），它只被 spec 引用，故可以安全地排除在 build 之外。
  // 两者仍受 `tsconfig.check.json`（typecheck）与 Vitest 覆盖。
  "exclude": ["src/**/*.spec.ts", "src/loopCalendar.ts", "lint-boundary"]
}
